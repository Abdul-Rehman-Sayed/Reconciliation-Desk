# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Secrets - never commit a real key
.env

# Per-run artefacts (the bundled datasets in backend/data/{standard,stress} ARE committed)
backend/data/runs/

# Machine-local state
backend/data/llm_budget.json
backend/data/llm_cache_mock.json

# NOT ignored, deliberately:
#   backend/data/llm_cache.json   - real Groq verdicts, paid for once. Committing it
#                                   means a fresh clone runs the demo at zero cost.
#                                   It holds model output, no keys.
#   backend/data/baselines/       - the frozen LLM-only measurement. Recomputing it
#                                   would spend tokens to re-derive a fixed number.

# Node
node_modules/
dist/
.vite/

