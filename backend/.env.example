# Groq API key - free tier, no credit card. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Leave blank to auto-pick the best model Groq is actually serving today.
# The app verifies any value here against GET /openai/v1/models before using it.
# Run `python scripts/check_limits.py` to see each model's real per-account limits,
# read off the live response headers rather than the published table.
GROQ_MODEL=

# ---------------------------------------------------------------------------
# Token discipline
# ---------------------------------------------------------------------------

# Return a rule-based stand-in instead of calling Groq. Costs nothing, needs no
# key, and never touches the network. Use it for ALL interface work - the screens
# under test see realistic content, and every verdict is stamped source="mock" so
# it can never be mistaken for real model output. Flip it off for a final
# validation run and the demo itself.
USE_MOCK_LLM=false

# Hard ceiling on live requests per day, tracked on disk in data/llm_budget.json
# and enforced locally - it does not depend on Groq being the one to say no.
# Set to 0 to block live calls entirely while leaving the cache readable.
GROQ_DAILY_CALL_BUDGET=120
